<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DarsJadvali.Desktop.Models"
        x:Class="DarsJadvali.Desktop.Views.DialogWindow"
        x:DataType="models:DialogModel"
        Title="{Binding Title}"
        Width="480"
        SizeToContent="Height"
        MinHeight="150"
        MaxHeight="600"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppSurfaceBrush}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="0">

    <!-- Sarlavha -->
    <Border Grid.Row="0"
            Background="{StaticResource AppHeaderBrush}"
            Padding="20,14">
      <TextBlock Text="{Binding Title}"
                 FontSize="16"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource AppTextBrush}" />
    </Border>

    <!-- Matn -->
    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="20,16">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Message}"
                   IsVisible="{Binding HasMessage}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{Binding MessageColorCode, Converter={StaticResource ColorCodeToBrush}}" />

        <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding HasLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:DialogLine">
              <TextBlock Text="{Binding Text}"
                         TextWrapping="Wrap"
                         FontSize="13"
                         Margin="0,3,0,3"
                         Foreground="{Binding ColorCode, Converter={StaticResource ColorCodeToBrush}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Tugmalar -->
    <Border Grid.Row="2"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,12">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10">
        <Button x:Name="SecondaryButton"
                Content="{Binding SecondaryText}"
                IsVisible="{Binding HasSecondary}"
                MinWidth="110"
                Click="OnSecondaryClick" />
        <Button x:Name="PrimaryButton"
                Content="{Binding PrimaryText}"
                MinWidth="110"
                IsDefault="True"
                Click="OnPrimaryClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
