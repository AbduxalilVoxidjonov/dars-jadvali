<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DarsJadvali.Desktop.ViewModels"
             xmlns:entities="clr-namespace:DarsJadvali.Domain.Entities;assembly=DarsJadvali.Domain"
             x:Class="DarsJadvali.Desktop.Views.TimetableView"
             x:DataType="vm:TimetableViewModel">

  <UserControl.Styles>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!--
      Katak ranglari endi ViewModel'da emas, shu yerda (M-06).
      ViewModel faqat semantik holat beradi: Header / Empty / Occupied / Warning / Conflict.
    -->
    <Style Selector="Border.cell">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.cell.header">
      <Setter Property="Background" Value="{DynamicResource AppHeaderBrush}" />
    </Style>

    <Style Selector="Border.cell.warning">
      <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Border.cell.conflict">
      <Setter Property="BorderBrush" Value="{DynamicResource AppErrorBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Tanlov eng ustun ko'rinish — oxirida turadi. -->
    <Style Selector="Border.cell.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AppSelectionBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- Jadval to'rining bitta katagi -->
    <DataTemplate x:Key="TimetableCellTemplate" x:DataType="vm:TimetableCellViewModel">
      <Border Classes="cell"
              Classes.header="{Binding State, Converter={StaticResource EnumToBoolean}, ConverterParameter=Header}"
              Classes.warning="{Binding State, Converter={StaticResource EnumToBoolean}, ConverterParameter=Warning}"
              Classes.conflict="{Binding State, Converter={StaticResource EnumToBoolean}, ConverterParameter=Conflict}"
              Classes.selected="{Binding IsSelected}"
              Margin="2"
              MinHeight="66"
              CornerRadius="5"
              ClipToBounds="True"
              PointerPressed="OnCellPointerPressed">

        <Border.ContextFlyout>
          <MenuFlyout>
            <MenuItem Header="O'chirish"
                      Command="{Binding DeleteCommand}"
                      IsEnabled="{Binding HasEntry}" />
          </MenuFlyout>
        </Border.ContextFlyout>

        <Panel>
          <!-- Band katakning foni — o'qituvchi rangining ochiq toni (konverter orqali) -->
          <Border CornerRadius="5"
                  IsVisible="{Binding State, Converter={StaticResource EnumToBoolean}, ConverterParameter=Occupied}"
                  Background="{Binding ColorCode, Converter={StaticResource ColorCodeToBrush}, ConverterParameter=Light}" />

          <!-- Sarlavha katagi -->
          <StackPanel VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Margin="6"
                      IsVisible="{Binding IsHeader}">
            <TextBlock Text="{Binding HeaderText}"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding HeaderSubText}"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       IsVisible="{Binding HasHeaderSubText}" />
          </StackPanel>

          <!-- Dars katagi -->
          <StackPanel VerticalAlignment="Center" Margin="6" IsVisible="{Binding IsLessonCell}">
            <TextBlock Text="{Binding SubjectName}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding PersonName}"
                       FontSize="11"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppMutedTextBrush}" />
            <TextBlock Text="{Binding RoomDisplayText}"
                       FontSize="10"
                       IsVisible="{Binding HasRoom}"
                       Foreground="{DynamicResource AppMutedTextBrush}" />
          </StackPanel>
        </Panel>
      </Border>
    </DataTemplate>

    <!-- Konflikt qatori — ranglar konverter orqali (M-06) -->
    <DataTemplate x:Key="ConflictTemplate" x:DataType="vm:ConflictRowViewModel">
      <Border Background="{Binding Severity, Converter={StaticResource ConflictSeverityToBrush}, ConverterParameter=Background}"
              CornerRadius="4"
              Padding="8,6"
              Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal">
          <Border Width="4"
                  CornerRadius="2"
                  Margin="0,0,8,0"
                  Background="{Binding Severity, Converter={StaticResource ConflictSeverityToBrush}}" />
          <TextBlock Text="{Binding Message}"
                     TextWrapping="Wrap"
                     MaxWidth="260"
                     Foreground="{Binding Severity, Converter={StaticResource ConflictSeverityToBrush}}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="20" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto">

    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
               Classes="AppPageTitle"
               Text="Dars jadvali" />

    <!-- Yuqori panel: rejim va filtr -->
    <Border Grid.Row="1" Grid.Column="0"
            Classes="panel"
            Padding="14,10"
            Margin="0,0,0,12">
      <WrapPanel VerticalAlignment="Center">
        <RadioButton Content="Sinf bo'yicha"
                     GroupName="TimetableMode"
                     IsChecked="{Binding IsClassMode, Mode=TwoWay}"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0" />
        <RadioButton Content="O'qituvchi bo'yicha"
                     GroupName="TimetableMode"
                     IsChecked="{Binding IsTeacherMode, Mode=TwoWay}"
                     VerticalAlignment="Center"
                     Margin="0,0,20,0" />

        <ComboBox ItemsSource="{Binding ClassGroups}"
                  SelectedItem="{Binding FilterClassGroup, Mode=TwoWay}"
                  MinWidth="170"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding IsClassMode}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="entities:SchoolClass">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <ComboBox ItemsSource="{Binding Teachers}"
                  SelectedItem="{Binding FilterTeacher, Mode=TwoWay}"
                  MinWidth="210"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding IsTeacherMode}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="entities:Teacher">
              <TextBlock Text="{Binding FullName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Content="Yangilash"
                Command="{Binding RefreshGridCommand}"
                Margin="0,0,8,0" />

        <Button Content="PDF yuklab olish"
                Command="{Binding ExportPdfCommand}"
                Margin="0,0,8,0" />

        <Button Content="Jadvalni tozalash"
                Command="{Binding ClearScheduleCommand}"
                Foreground="{DynamicResource AppErrorBrush}" />
      </WrapPanel>
    </Border>

    <!-- To'r -->
    <Border Grid.Row="2" Grid.Column="0" Classes="panel" Padding="8">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Cells}"
                      ItemTemplate="{StaticResource TimetableCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding GridColumnCount}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- O'ng panel: dars qo'yish -->
    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
            Classes="panel"
            Width="340"
            Margin="16,0,0,0"
            Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Classes="AppSectionTitle" Text="Dars qo'yish" />

          <Border Background="{DynamicResource AppHeaderBrush}"
                  CornerRadius="4"
                  Padding="10,8"
                  Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Classes="AppHintText" Text="Tanlangan katak:" />
              <TextBlock Text="{Binding SelectedCellText}"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <TextBlock Classes="AppHintText" Text="Sinf" />
          <ComboBox ItemsSource="{Binding ClassGroups}"
                    SelectedItem="{Binding PlaceClassGroup, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    Margin="0,2,0,12">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="entities:SchoolClass">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!--
            Fan + o'qituvchi o'rniga REJADAGI dars tanlanadi: yangi modelda kartochka
            har doim mavjud Lesson ga tegishli bo'ladi. Ro'yxatda faqat hali
            joylashtirilmagan soatlar ko'rinadi (GetUnplacedAsync ning aniq natijasi).
          -->
          <TextBlock Classes="AppHintText" Text="Joylashtirilmagan dars" />
          <ComboBox ItemsSource="{Binding VisiblePlaceLessons}"
                    SelectedItem="{Binding PlaceLesson, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    Margin="0,2,0,12">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:UnplacedLessonOption">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!--
            Xona kartochkaga dars ta'rifidagi xona ro'yxatidan (yoki sinfning asosiy
            xonasidan) tayinlanadi — bu yerda qo'lda kiritilmaydi.
          -->
          <TextBlock Classes="AppHintText"
                     TextWrapping="Wrap"
                     Margin="0,0,0,14"
                     Text="Xona sinfning asosiy xonasidan olinadi." />

          <StackPanel Orientation="Horizontal">
            <Button Content="Qo'yish"
                    Command="{Binding PlaceCommand}"
                    Padding="24,5" />
            <Button Content="Katakni bo'shatish"
                    Command="{Binding DeleteSelectedCommand}"
                    Foreground="{DynamicResource AppErrorBrush}"
                    Margin="10,0,0,0" />
          </StackPanel>

          <TextBlock Text="{Binding PlacementSummary}"
                     Margin="0,14,0,0"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasPlacementSummary}" />

          <ItemsControl ItemsSource="{Binding PlacementConflicts}"
                        ItemTemplate="{StaticResource ConflictTemplate}"
                        Margin="0,10,0,0" />

          <TextBlock Classes="AppHintText"
                     Margin="0,16,0,0"
                     TextWrapping="Wrap"
                     Text="Maslahat: katakni sichqonchaning chap tugmasi bilan tanlang, o'ng tugma bilan bosib darsni o'chiring." />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
