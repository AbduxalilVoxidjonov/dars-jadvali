<Application x:Class="DarsJadvali.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Teal" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="Resources/Converters.xaml" />
                <ResourceDictionary Source="Resources/ViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Umumiy ranglar (MaterialDesign kalitlariga bog'lanmasdan) -->
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F5F7" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="AppHeaderBrush" Color="#EDE7F6" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#212121" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#757575" />
            <SolidColorBrush x:Key="AppErrorBrush" Color="#C62828" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#EF6C00" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#2E7D32" />
            <SolidColorBrush x:Key="AppSelectionBrush" Color="#1565C0" />

            <Style x:Key="AppPageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="AppSectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="AppHintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
