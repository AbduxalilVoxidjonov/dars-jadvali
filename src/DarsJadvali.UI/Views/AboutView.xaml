<UserControl x:Class="DarsJadvali.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:DarsJadvali.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Dastur haqida" Style="{StaticResource AppPageTitle}" />

            <!-- Umumiy ma'lumot -->
            <Border Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22"
                    Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarClock" Width="40" Height="40" Foreground="#5E35B1" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppName}" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="{Binding VersionText}"
                                       Foreground="{StaticResource AppMutedTextBrush}"
                                       FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding Description}"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0"
                               FontSize="14" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Muallif:"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Author}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Telegram:"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Row="1" Grid.Column="1"
                                Command="{Binding OpenTelegramCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Left"
                                Padding="0"
                                Cursor="Hand"
                                ToolTip="{Binding TelegramUrl}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Send" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TelegramHandle}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           TextDecorations="Underline" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hissa qo'shish -->
            <Border Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22"
                    Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HeartOutline" Width="22" Height="22" Foreground="#C2185B" VerticalAlignment="Center" />
                        <TextBlock Text="Loyihani rivojlantirishga hissa qo'shish"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource AppHintText}"
                               Margin="0,10,0,0"
                               Text="Dastur bepul tarqatiladi. Agar u sizga foydali bo'lgan bo'lsa, quyidagi karta orqali muallifni qo'llab-quvvatlashingiz mumkin." />

                    <Border Background="#F5F1FB"
                            BorderBrush="#D6C9F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CreditCardOutline" Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DonateCardType}"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBox Text="{Binding DonateCardNumber, Mode=OneWay}"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontFamily="Consolas"
                                     FontSize="30"
                                     FontWeight="Bold"
                                     Margin="0,12,0,0"
                                     Padding="0"
                                     HorizontalAlignment="Left" />

                            <TextBlock Text="{Binding DonateCardHolder}"
                                       Margin="0,6,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource AppMutedTextBrush}" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Command="{Binding CopyCardNumberCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="20,5">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18" VerticalAlignment="Center" />
                                        <TextBlock Text="Nusxa olish" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="{Binding CopyFeedback}"
                                           Foreground="{StaticResource AppSuccessBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0"
                                           Visibility="{Binding CopyFeedback, Converter={StaticResource EmptyStringToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
