<UserControl x:Class="DarsJadvali.UI.Views.AssignmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:DarsJadvali.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AssignmentsViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Biriktirmalar" Style="{StaticResource AppPageTitle}" />

        <!-- Chapda: o'qituvchilar -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,16,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="O'qituvchilar"
                           Style="{StaticResource AppSectionTitle}"
                           Margin="14,12,14,6" />
                <ListBox ItemsSource="{Binding Teachers}"
                         SelectedItem="{Binding SelectedTeacher, Mode=TwoWay}"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Border Width="12" Height="12" CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{Binding ColorCode, Converter={StaticResource ColorCodeToBrush}}" />
                                <TextBlock Text="{Binding FullName}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- O'ngda: biriktirmalar -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource AppSectionTitle}" />
                    <TextBlock Style="{StaticResource AppHintText}"
                               Margin="0,0,0,10"
                               Text="{Binding SelectedTeacher.FullName, StringFormat='Tanlangan: {0}'}" />

                    <WrapPanel>
                        <ComboBox ItemsSource="{Binding Subjects}"
                                  SelectedItem="{Binding EditSubject, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="Fan"
                                  Width="220"
                                  Margin="0,0,12,10" />

                        <ComboBox ItemsSource="{Binding ClassGroups}"
                                  SelectedItem="{Binding EditClassGroup, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="Sinf"
                                  Width="180"
                                  Margin="0,0,12,10" />

                        <TextBox Text="{Binding EditWeeklyHours, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Haftalik soat"
                                 Width="140"
                                 Margin="0,0,12,10" />

                        <Button Content="Saqlash"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Padding="20,4"
                                Height="38"
                                Margin="0,0,10,10" />

                        <Button Content="Tozalash"
                                Command="{Binding CancelEditCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="38"
                                Margin="0,0,0,10" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <DataGrid ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="Transparent"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fan" Binding="{Binding SubjectName}" Width="*" />
                        <DataGridTextColumn Header="Sinf" Binding="{Binding ClassGroupName}" Width="120" />
                        <DataGridTextColumn Header="Haftalik soat" Binding="{Binding WeeklyHoursCount}" Width="120" />
                        <DataGridTemplateColumn Header="Holati" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6">
                                        <TextBlock Text="{Binding HoursSummary}" FontSize="12" />
                                        <ProgressBar Minimum="0"
                                                     Maximum="{Binding WeeklyHours}"
                                                     Value="{Binding PlacedHours, Mode=OneWay}"
                                                     Height="6"
                                                     Margin="0,4,8,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Amallar" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Tahrirlash"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="8,2"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="O'chirish"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="8,2"
                                                Foreground="{StaticResource AppErrorBrush}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
