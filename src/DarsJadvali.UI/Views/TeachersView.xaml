<UserControl x:Class="DarsJadvali.UI.Views.TeachersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:DarsJadvali.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TeachersViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="O'qituvchilar" Style="{StaticResource AppPageTitle}" />

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Yangi qo'shish"
                    Command="{Binding NewCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Padding="16,4" />
            <Button Content="Tahrirlash"
                    Command="{Binding EditCommand}"
                    CommandParameter="{Binding SelectedTeacher}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="10,0,0,0"
                    Padding="16,4"
                    IsEnabled="{Binding SelectedTeacher, Converter={StaticResource NotNullToBoolean}}" />
            <Button Content="O'chirish"
                    Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding SelectedTeacher}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="10,0,0,0"
                    Padding="16,4"
                    Foreground="{StaticResource AppErrorBrush}"
                    IsEnabled="{Binding SelectedTeacher, Converter={StaticResource NotNullToBoolean}}" />
            <Button Content="Yangilash"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="10,0,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="2" Grid.Column="0"
                  ItemsSource="{Binding Teachers}"
                  SelectedItem="{Binding SelectedTeacher, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{StaticResource AppSurfaceBrush}"
                  BorderBrush="{StaticResource AppBorderBrush}"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Rang" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{Binding ColorCode, Converter={StaticResource ColorCodeToBrush}}"
                                    HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Familiya, ism" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="160" />
                <DataGridTemplateColumn Header="Faol" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsActive, Mode=OneWay}"
                                      IsHitTestVisible="False"
                                      HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Tahrirlash paneli -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                Width="340"
                Margin="20,0,0,0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18"
                VerticalAlignment="Top"
                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource AppSectionTitle}" />

                <TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Familiya, ism"
                         Margin="0,10,0,0" />

                <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Telefon (ixtiyoriy)"
                         Margin="0,16,0,0" />

                <ComboBox ItemsSource="{Binding Colors}"
                          SelectedItem="{Binding EditColor, Mode=TwoWay}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Rang"
                          Margin="0,16,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="18" Height="18" CornerRadius="9"
                                        Background="{Binding Code, Converter={StaticResource ColorCodeToBrush}}" />
                                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <CheckBox Content="Faol o'qituvchi"
                          IsChecked="{Binding EditIsActive, Mode=TwoWay}"
                          Margin="0,18,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
                    <Button Content="Bekor qilish"
                            Command="{Binding CancelEditCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                    <Button Content="Saqlash"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="10,0,0,0"
                            Padding="20,4" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
