<UserControl x:Class="DarsJadvali.UI.Views.WorkDaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:DarsJadvali.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WorkDaysViewModel}">

    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Hafta kunlari" Style="{StaticResource AppPageTitle}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Saqlash"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Padding="26,6" />
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Foreground="{StaticResource AppMutedTextBrush}" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Kunlar -->
            <Border Grid.Row="0"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Ish kunlari va kunlik darslar soni" Style="{StaticResource AppSectionTitle}" />

                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DayName}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />

                                    <CheckBox Grid.Column="1"
                                              Content="Faol"
                                              IsChecked="{Binding IsActive, Mode=TwoWay}"
                                              VerticalAlignment="Center" />

                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding DataContext.LessonCountOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding MaxLessonsPerDay, Mode=TwoWay}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              materialDesign:HintAssist.Hint="Darslar soni"
                                              IsEnabled="{Binding IsActive}"
                                              Width="140" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Dars soatlari -->
            <Border Grid.Row="1"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Dars soatlari jadvali" Style="{StaticResource AppSectionTitle}" VerticalAlignment="Center" />
                        <Button Content="Soat qo'shish"
                                Command="{Binding AddSlotCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="20,0,0,0"
                                Padding="14,2" />
                        <TextBlock Text="Vaqt formati: HH:mm (masalan 08:30)"
                                   Style="{StaticResource AppHintText}"
                                   VerticalAlignment="Center"
                                   Margin="18,0,0,0" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Slots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Text="{Binding LessonNumber, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Dars raqami"
                                                 Margin="0,0,10,0" />

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Boshlanish"
                                                 Margin="0,0,10,0" />

                                        <TextBox Grid.Column="2"
                                                 Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Tugash"
                                                 Margin="0,0,10,0" />

                                        <Button Grid.Column="3"
                                                Content="O'chirish"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="{StaticResource AppErrorBrush}"
                                                Command="{Binding DataContext.RemoveSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
