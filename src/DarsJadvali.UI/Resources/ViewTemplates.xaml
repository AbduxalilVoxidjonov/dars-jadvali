<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DarsJadvali.UI.ViewModels"
                    xmlns:views="clr-namespace:DarsJadvali.UI.Views">

    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TeachersViewModel}">
        <views:TeachersView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SubjectsViewModel}">
        <views:SubjectsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ClassGroupsViewModel}">
        <views:ClassGroupsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AssignmentsViewModel}">
        <views:AssignmentsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:WorkDaysViewModel}">
        <views:WorkDaysView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AvailabilityViewModel}">
        <views:AvailabilityView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TimetableViewModel}">
        <views:TimetableView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AboutViewModel}">
        <views:AboutView />
    </DataTemplate>

</ResourceDictionary>
